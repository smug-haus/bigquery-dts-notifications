{
  "name": "fmcourse",
  "version": "0.3.0",
  "description": "Interactive companion CLI for the Formal Methods course.",
  "bin": {
    "fmcourse": "./dist/src/cli.js"
  },
  "main": "./dist/src/cli.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
